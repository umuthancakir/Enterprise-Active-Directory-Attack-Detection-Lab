# Copy to .env and fill in. .env is gitignored — never commit real values.
# See README.md "Deployment target" and docs/adr/0004-revert-to-local-utm.md.

# ---- Deploy target -----------------------------------------------------
DEPLOY_TARGET=local

# ---- Local (UTM/QEMU) — required when DEPLOY_TARGET=local ---------------
# Used by infra/local/build.sh and infra/local/build-linux.sh. Get exact
# URLs/checksums from the vendor download pages — see each variable's
# description in the corresponding .pkr.hcl file, and never trust a stale
# checksum you find elsewhere.
ADMIN_PASSWORD=change-me-generate-a-random-one
WIN_ISO_URL=
WIN_ISO_CHECKSUM=
KALI_ISO_URL=
KALI_ISO_CHECKSUM=
UBUNTU_IMG_CHECKSUM=

# ---- Azure (deprecated — see docs/adr/0004-revert-to-local-utm.md) -----
# infra/azure/ was removed from the tree; these are kept commented as a
# pointer in case that path is ever revisited (recoverable from git history
# at commit 67ce0f3).
# AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
# AZURE_REGION=eastus
# AZURE_RESOURCE_GROUP=eadadl-lab-rg

# ---- Lab domain / synthetic credentials --------------------------------
# All synthetic — never real identities. Generated per-deploy is preferred;
# these are placeholders for local override during development.
LAB_DOMAIN_NAME=eadadl.lab
LAB_DOMAIN_NETBIOS=EADADL
LAB_ADMIN_USERNAME=labadmin
LAB_ADMIN_PASSWORD=change-me-generate-a-random-one

# ---- SIEM ---------------------------------------------------------------
SIEM_BACKEND=elastic            # elastic | wazuh | splunk
SIEM_ADMIN_PASSWORD=change-me-generate-a-random-one

# ---- Platform backend (FastAPI) -----------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=eadadl
POSTGRES_USER=eadadl
POSTGRES_PASSWORD=change-me-generate-a-random-one
BACKEND_SECRET_KEY=change-me-generate-a-random-one
BACKEND_CORS_ORIGINS=http://localhost:3000
# Bootstrap operator account — created on first startup if no users exist
# yet. See platform/backend/app/auth.py.
BACKEND_ADMIN_USERNAME=admin
BACKEND_ADMIN_PASSWORD=change-me-generate-a-random-one

# ---- Platform frontend ---------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
