# Copy to .env and fill in. .env is gitignored — never commit real values.
# See README.md "Deployment target" and docs/adr/0001-deploy-target.md.

# ---- Deploy target -----------------------------------------------------
DEPLOY_TARGET=azure

# ---- Azure (required when DEPLOY_TARGET=azure) -------------------------
# Auth: default is interactive `az login` (see docs/adr/0001-deploy-target.md).
# Terraform's azurerm provider then uses your az CLI session automatically —
# you do NOT need to fill in AZURE_CLIENT_ID/SECRET below unless you're
# switching to service-principal auth (e.g. for CI).
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
AZURE_REGION=eastus
AZURE_RESOURCE_GROUP=eadadl-lab-rg

# Only needed for service-principal auth (CI / non-interactive use):
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_CLIENT_SECRET=

# ---- Lab domain / synthetic credentials --------------------------------
# All synthetic — never real identities. Generated per-deploy is preferred;
# these are placeholders for local override during development.
LAB_DOMAIN_NAME=eadadl.lab
LAB_DOMAIN_NETBIOS=EADADL
LAB_ADMIN_USERNAME=labadmin
LAB_ADMIN_PASSWORD=change-me-generate-a-random-one

# ---- SIEM ---------------------------------------------------------------
SIEM_BACKEND=elastic            # elastic | wazuh | splunk
SIEM_ADMIN_PASSWORD=change-me-generate-a-random-one

# ---- Platform backend (FastAPI) -----------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=eadadl
POSTGRES_USER=eadadl
POSTGRES_PASSWORD=change-me-generate-a-random-one
BACKEND_SECRET_KEY=change-me-generate-a-random-one
BACKEND_CORS_ORIGINS=http://localhost:3000

# ---- Platform frontend ---------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
