# infra/local/packer/ubuntu-siem.pkr.hcl
#
# Builds siem01 from Ubuntu Server 22.04 LTS's official ARM64 cloud image
# (a pre-installed qcow2, not an ISO installer) plus a NoCloud cloud-init
# seed — the standard, low-risk way to automate an Ubuntu build, and
# notably simpler/more reliable than the Debian-installer preseed approach
# used for attacker01 (see kali-attacker.pkr.hcl) since there's no
# installer UI automation involved at all.

packer {
  required_plugins {
    qemu = {
      source  = "github.com/hashicorp/qemu"
      version = "~> 1.1"
    }
  }
}

variable "base_image_url" {
  type        = string
  default     = "https://cloud-images.ubuntu.com/releases/22.04/release/ubuntu-22.04-server-cloudimg-arm64.img"
  description = "Ubuntu 22.04 LTS ARM64 cloud image. Canonical's URL scheme has been stable for years, but re-verify the checksum below against https://cloud-images.ubuntu.com/releases/22.04/release/SHA256SUMS before relying on it."
}

variable "base_image_checksum" {
  type        = string
  description = "sha256:<hash> for base_image_url — fetch current value from the SHA256SUMS file at the URL above; no default, must be supplied."
}

variable "admin_username" {
  type    = string
  default = "labadmin"
}

variable "firmware" {
  type    = string
  default = "/opt/homebrew/share/qemu/edk2-aarch64-code.fd"
}

variable "output_directory" {
  type    = string
  default = "infra/local/build/images/siem01"
}

source "qemu" "ubuntu_siem" {
  iso_url      = var.base_image_url
  iso_checksum = var.base_image_checksum
  # This is a pre-built cloud image, not an installer ISO — Packer's qemu
  # builder still calls the source file "iso_url" internally, but disk_image
  # tells it to boot the file directly as a disk rather than treating it as
  # installer media.
  disk_image       = true
  output_directory = var.output_directory
  vm_name          = "siem01.qcow2"
  format           = "qcow2"

  qemu_binary  = "qemu-system-aarch64"
  accelerator  = "hvf"
  machine_type = "virt"
  firmware     = var.firmware
  cpu_model    = "host"

  cpus      = 2
  memory    = 4096
  disk_size = "40000M" # Elastic/Wazuh indices during scenario runs — see infra/azure/siem.tf history for the same sizing rationale (git log)

  net_device     = "virtio-net"
  disk_interface = "virtio"

  headless = true

  # NoCloud cloud-init datasource via a labeled ISO — generated by
  # infra/local/build-linux.sh from user-data.tmpl before this runs (same
  # substitution problem as the Windows Autounattend password, see that
  # script's comments).
  cd_files = ["${path.root}/http-linux/user-data", "${path.root}/http-linux/meta-data"]
  cd_label = "cidata"

  communicator         = "ssh"
  ssh_username         = var.admin_username
  ssh_private_key_file = "infra/local/build/ssh/lab_ed25519"
  ssh_timeout          = "30m" # native arm64, no TCG emulation — should be fast

  shutdown_command = "sudo -S shutdown -P now"
}

build {
  sources = ["source.qemu.ubuntu_siem"]

  provisioner "shell" {
    inline = [
      "sudo apt-get update",
      "sudo apt-get install -y qemu-guest-agent",
      "sudo systemctl enable qemu-guest-agent"
    ]
  }
}
